generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  OPERATOR
  COMPANY
  ADMIN
}

enum CollectionPointStatus {
  ACTIVE
  INACTIVE
}

enum MaterialType {
  PET_PLASTIC
  OTHER_PLASTIC
  ALUMINUM
  GLASS
  PAPER
  CARDBOARD
  ELECTRONICS
}

enum RecyclingStatus {
  PENDING
  VERIFIED
  REJECTED
  RECORDED_ONCHAIN
  ONCHAIN_FAILED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  name                String
  walletAddress       String?              @unique
  passwordHash        String?
  role                UserRole             @default(USER)
  recyclingEvents     RecyclingEvent[]     @relation("RecyclerEvents")
  verifiedEvents      RecyclingEvent[]     @relation("OperatorEvents")
  operatorAssignments OperatorAssignment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model CollectionPoint {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String
  address            String
  latitude           Float
  longitude          Float
  supportedMaterials MaterialType[]
  status             CollectionPointStatus @default(ACTIVE)
  operators          OperatorAssignment[]
  recyclingEvents    RecyclingEvent[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status])
}

model OperatorAssignment {
  id                String          @id @default(uuid()) @db.Uuid
  operatorId        String          @db.Uuid
  collectionPointId String          @db.Uuid
  operator          User            @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([operatorId, collectionPointId])
  @@index([collectionPointId])
}

model Campaign {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  materialType    MaterialType
  rewardRecPerKg  Int
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean          @default(true)
  recyclingEvents   RecyclingEvent[]
  impactCertificates ImpactCertificate[]
  createdAt         DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([active, startsAt, endsAt])
}

model RecyclingEvent {
  id                String          @id @default(uuid()) @db.Uuid
  publicId          String          @unique
  recyclerId        String          @db.Uuid
  collectionPointId String          @db.Uuid
  campaignId        String?         @db.Uuid
  operatorId        String?         @db.Uuid
  materialType      MaterialType
  weightGrams       Int
  status            RecyclingStatus @default(PENDING)
  rewardPoints      Int             @default(0)
  proofHash         String?         @unique
  solanaSignature   String?         @unique
  rejectionReason   String?
  metadata          Json?
  recycler          User            @relation("RecyclerEvents", fields: [recyclerId], references: [id])
  collectionPoint   CollectionPoint @relation(fields: [collectionPointId], references: [id])
  campaign          Campaign?       @relation(fields: [campaignId], references: [id])
  operator          User?           @relation("OperatorEvents", fields: [operatorId], references: [id])
  createdAt         DateTime        @default(now())
  verifiedAt        DateTime?
  recordedOnchainAt DateTime?
  updatedAt         DateTime        @updatedAt

  @@index([recyclerId, createdAt])
  @@index([collectionPointId, createdAt])
  @@index([campaignId, createdAt])
  @@index([status])
}

model ImpactCertificate {
  id                 String   @id @default(uuid()) @db.Uuid
  certificateId      String   @unique @db.Uuid
  campaignId         String   @db.Uuid
  companyWallet      String
  recBurned          Int
  retiredWeightGrams Int
  certificatePda     String   @unique
  solanaSignature    String   @unique
  network            String
  createdOnchainAt   DateTime
  campaign           Campaign @relation(fields: [campaignId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([campaignId, createdAt])
  @@index([companyWallet, createdAt])
}
