NODE_ENV=development
PORT=3333

# Local PostgreSQL used by docker-compose
DATABASE_URL=postgresql://recychain:recychain@localhost:5432/recychain?schema=public

# Frontend
CORS_ORIGIN=http://localhost:5173

# Blockchain
BLOCKCHAIN_MODE=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_PROGRAM_ID=9bQFX3gtGKwN6he7bkRWRFXQRLdBk1YE4YcHYEzcgoaG
SOLANA_AUTHORITY_KEYPAIR=/home/YOUR_USER/.config/solana/id.json

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
